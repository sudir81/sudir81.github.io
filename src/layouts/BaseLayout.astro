---
import '../styles/global.css';
import { profile } from '../data/profile';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string; path?: string; }
const defaultDesc = `${profile.name} is a freelance web and mobile app developer in Texas building apps with React, React Native, TypeScript and GraphQL.`;
const { title = `${profile.name} | ${profile.title}`, description = defaultDesc, path = '/' } = Astro.props;
const canonical = new URL(path, profile.site).href;
const ogImage = new URL('/og-image.png', profile.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  url: profile.site,
  sameAs: [profile.github, profile.linkedin],
};
const nav = [['Work', '/#work'], ['About', '/#about'], ['Skills', '/#skills'], ['Services', '/#services'], ['Contact', '/#contact']];
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#4f46e5" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
      } catch (e) {}
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent-600 focus:px-3 focus:py-2 focus:text-white">Skip to content</a>
    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a href="/" class="text-lg font-bold text-slate-900 dark:text-white" aria-label="SP, Sudheer Papineni home">SP<span class="text-accent-600 dark:text-accent-400">.</span></a>
        <div class="flex items-center gap-1 sm:gap-4">
          <nav aria-label="Main" class="hidden sm:block">
            <ul class="flex items-center gap-5 text-sm font-medium">
              {nav.map(([label, href]) => <li><a href={href} class="text-slate-600 hover:text-accent-600 dark:text-slate-300 dark:hover:text-accent-300">{label}</a></li>)}
            </ul>
          </nav>
          <ThemeToggle />
        </div>
      </div>
      <nav aria-label="Sections" class="mx-auto flex max-w-5xl gap-5 overflow-x-auto px-4 pb-2 text-sm font-medium sm:hidden">
        {nav.map(([label, href]) => <a href={href} class="shrink-0 py-1 text-slate-600 dark:text-slate-300">{label}</a>)}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <Footer />
    <script>
      const els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        els.forEach((e) => e.classList.add('visible'));
      } else {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
        }), { threshold: 0.1 });
        els.forEach((e) => io.observe(e));
      }
    </script>
  </body>
</html>
