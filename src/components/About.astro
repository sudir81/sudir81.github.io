---
import { profile } from '../data/profile';
---
<section id="about" class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
  <div class="reveal grid gap-10 md:grid-cols-5">
    <div class="md:col-span-3">
      <p class="eyebrow">About</p>
      <h2 class="section-title">Building things people enjoy using</h2>
      <div class="mt-6 space-y-4 text-lg leading-relaxed">
        {profile.bio.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <div class="md:col-span-2">
      <div class="rounded-2xl border border-slate-200 p-6 dark:border-slate-800">
        <h3 class="font-semibold text-slate-900 dark:text-white">Working with me</h3>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{profile.location}</p>
        <ul class="mt-4 space-y-3 text-sm">
          {profile.offer.map((o) => (
            <li class="flex gap-2"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-600 dark:text-accent-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0z" clip-rule="evenodd"/></svg><span>{o}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
