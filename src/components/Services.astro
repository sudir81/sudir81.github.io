---
import { profile } from '../data/profile';
const icons: Record<string, string> = {
  web: 'M3 5h18v12H3zM8 21h8M12 17v4',
  mobile: 'M8 2h8a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1zM11 18h2',
  refresh: 'M4 12a8 8 0 0 1 14-5.3L20 9M20 4v5h-5M20 12a8 8 0 0 1-14 5.3L4 15M4 20v-5h5',
  check: 'M9 12l2 2 4-4M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z',
};
---
<section id="services" class="bg-slate-50 py-16 dark:bg-slate-900/40">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="reveal">
      <p class="eyebrow">Services</p>
      <h2 class="section-title">How I can help</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {profile.services.map((s) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
            <svg class="h-7 w-7 text-accent-600 dark:text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[s.icon]} /></svg>
            <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">{s.title}</h3>
            <p class="mt-2 text-sm">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
