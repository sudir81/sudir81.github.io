---
import { skills } from '../data/skills';
---
<section id="skills" class="bg-slate-50 py-16 dark:bg-slate-900/40">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="reveal">
      <p class="eyebrow">Skills</p>
      <h2 class="section-title gradient-title">Tools I work with</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {Object.entries(skills).map(([group, items]) => (
          <div class="spotlight rounded-2xl border border-slate-200 bg-white p-5 transition duration-300 hover:-translate-y-1 hover:border-accent-400 dark:border-slate-800 dark:bg-slate-900">
            <h3 class="font-semibold text-slate-900 dark:text-white">{group}</h3>
            <ul class="mt-3 flex flex-wrap gap-2">{items.map((s) => <li class="tag">{s}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
