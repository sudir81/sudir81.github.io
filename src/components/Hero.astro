---
import { Image } from 'astro:assets';
import avatar from '../data/avatar.jpg';
import background from '../data/background.jpg';
import { profile } from '../data/profile';
---
<section class="relative isolate overflow-hidden bg-slate-950">
  <Image src={background} alt="" width={1280} loading="eager" class="absolute inset-0 -z-20 h-full w-full object-cover" aria-hidden="true" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-950/85 via-slate-950/60 to-indigo-950/30" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-5xl flex-col-reverse items-center gap-10 px-4 py-16 sm:px-6 md:flex-row md:justify-between md:py-28">
    <div class="reveal text-center md:text-left">
      <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-accent-300">{profile.title}</p>
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-6xl">Hi, I'm {profile.name}.</h1>
      <p class="mt-5 max-w-xl text-lg text-slate-200">{profile.intro}</p>
      <p class="mt-2 text-sm text-slate-300">{profile.location}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
        <a href="#work" class="btn bg-white text-accent-700 hover:bg-accent-50">View Work</a>
        <a href={profile.github} class="btn border border-white/40 text-white hover:bg-white/10" rel="noopener">GitHub</a>
        <a href="#contact" class="btn border border-white/40 text-white hover:bg-white/10">Contact</a>
        {profile.resume && <a href={profile.resume} class="btn border border-white/40 text-white hover:bg-white/10">Resume</a>}
      </div>
    </div>
    <div class="reveal shrink-0">
      <Image src={avatar} alt={`Portrait of ${profile.name}`} width={240} height={240} loading="eager" class="h-48 w-48 rounded-full object-cover shadow-xl ring-4 ring-white/30 sm:h-60 sm:w-60" />
    </div>
  </div>
</section>
