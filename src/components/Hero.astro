---
import { Image } from 'astro:assets';
import avatar from '../data/avatar.jpg';
import { profile } from '../data/profile';
---
<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-x-0 -top-24 -z-10 h-96 bg-gradient-to-b from-accent-100/70 to-transparent dark:from-accent-600/10" aria-hidden="true"></div>
  <div class="mx-auto flex max-w-5xl flex-col-reverse items-center gap-10 px-4 py-16 sm:px-6 md:flex-row md:py-28">
    <div class="reveal text-center md:text-left">
      <p class="eyebrow">{profile.title}</p>
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-6xl dark:text-white">Hi, I'm {profile.name}.</h1>
      <p class="mt-5 max-w-xl text-lg text-slate-600 dark:text-slate-300">{profile.intro}</p>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{profile.location}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
        <a href="#work" class="btn btn-primary">View Work</a>
        <a href={profile.github} class="btn btn-ghost" rel="noopener">GitHub</a>
        <a href="#contact" class="btn btn-ghost">Contact</a>
      </div>
    </div>
    <div class="reveal shrink-0">
      <Image src={avatar} alt={`Portrait of ${profile.name}`} width={240} height={240} loading="eager" class="h-48 w-48 rounded-full object-cover shadow-xl ring-4 ring-accent-500/30 sm:h-60 sm:w-60" />
    </div>
  </div>
</section>
